# ==========================================================================
# Apex Construction — contact form → GoHighLevel
#
# Copy this file to `.env` and fill in the two required values.
# `.env` is gitignored and is only used for local development
# (`vercel dev`). For the live site the same variables must be added in
# Vercel → Project → Settings → Environment Variables.
# ==========================================================================

# --- REQUIRED -------------------------------------------------------------

# Private Integration Token for the sub-account.
# In GHL: Settings → Private Integrations → Create new integration.
# Give it the scopes:  contacts.readonly, contacts.write
# Copy the token it shows you once — it starts with "pit-".
GHL_API_TOKEN=

# The Location (sub-account) ID the enquiries should land in.
# In GHL: Settings → Business Profile → Location ID.
# Or read it out of the browser URL: app.gohighlevel.com/v2/location/<THIS BIT>/
GHL_LOCATION_ID=


# --- OPTIONAL -------------------------------------------------------------
# All of these have sensible defaults. Leave them blank to use the default.

# Tags put on every enquiry, comma separated. The chosen service is added as a
# tag automatically (e.g. "home-extension"), so workflows can route on it.
# Default: website-enquiry
GHL_TAGS=

# Shows as the contact's "Source" in GHL.
# Default: Website — Contact Form
GHL_SOURCE=

# Assign every enquiry to one user. In GHL: Settings → My Staff → click the
# user → the ID is the last part of the URL. Leave blank for unassigned.
GHL_ASSIGNED_USER_ID=

# Country used for the contact record and for turning 07... numbers into
# +447... . Default: GB
CONTACT_COUNTRY=

# GHL API version header. Only change this if GHL tells you to.
# Default: 2021-07-28
GHL_API_VERSION=
